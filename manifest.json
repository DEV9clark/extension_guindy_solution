{
  "manifest_version": 3,
  "name": "Guindy Projects",
  "version": "1.0.0",
  "description": "Dashboard de projets rapide",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://guindytechnology-solutions.com/*",
    "https://localhost/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "build/index.html",
    "default_icon": {
      "16": "build/icon-16.png",
      "48": "build/icon-48.png",
      "128": "build/icon-128.png"
    }
  },
  "icons": {
    "16": "build/icon-16.png",
    "48": "build/icon-48.png",
    "128": "build/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}